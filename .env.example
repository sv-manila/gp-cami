APP_NAME=gp-cami
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Default connection = the golden_profile hub (read/write).
DB_CONNECTION=golden_profile

# ---- golden_profile hub ----
GP_DB_HOST=127.0.0.1
GP_DB_PORT=3306
GP_DB_DATABASE=golden_profile
GP_DB_USERNAME=gp_engine
GP_DB_PASSWORD=
# Seconds to wait for the hub before failing. Keeps an unreachable hub from
# turning every request into a multi-second hang.
GP_DB_CONNECT_TIMEOUT=3

# ---- streamline_local source (SELECT-only user) ----
SRC_DB_HOST=127.0.0.1
SRC_DB_PORT=3306
SRC_DB_DATABASE=streamline_local
SRC_DB_USERNAME=gp_source_ro
SRC_DB_PASSWORD=
SRC_DB_CONNECT_TIMEOUT=3

# ---- shared SSN encryption (streamlineverify/security) ----
GP_SSN_ENCRYPTION_KEY_ID=1
# The plaintext key CAMI hashes SSNs with: ssn_hash = sha512(ssn + key).
# Leave EMPTY for local dev — the key is resolved from the source
# encryption_keys registry via the security package's LocalStrategy.
# REQUIRED wherever that registry is unreachable or the active key is held by a
# non-local manager (e.g. AWS KMS): without it SSN matching is unavailable, and
# credential-search now answers 503 rather than silently ignoring a supplied SSN.
GP_SSN_PLAINTEXT_KEY=

# Plaintext key for encryption_keys rows with manager = 'local' — the same
# constant Streamlineverify\Security\Encryption\KeyManager\LocalStrategy
# returns. Ask a teammate for the value; left empty here because this repo is
# public.
GP_SSN_LOCAL_MANAGER_KEY=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
GP_ENGINE_QUEUE=gp-engine

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Test hub for tests/Support/HubTestCase.php. A DEDICATED scratch schema —
# HubTestCase migrates it and rolls each test back. Never point this at the real
# hub. Unset means the database-backed tests skip rather than run.
GP_TEST_DB_HOST=127.0.0.1
GP_TEST_DB_PORT=3306
GP_TEST_DB_DATABASE=gp_cami_test
GP_TEST_DB_USERNAME=root
GP_TEST_DB_PASSWORD=root
